{
  "name": "pseudo-dom",
  "description": "Mock the DOM on the server side for managing state and testing",
  "version": "0.11.0",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "author": "Joshua Heagle",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "htmldocs": "jsdoc -R MAIN.md -r src/ -d docs",
    "readme": "gulp readme",
    "test": "gulp testFull",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:quick": "gulp testQuick",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest"
  },
  "dependencies": {
    "collect-your-stuff": "^2.1.2",
    "core-js": "^3.50.0",
    "css-select": "^6.0.0",
    "htmlparser2": "^9.1.0",
    "si-funciona": "^2.6.1"
  },
  "devDependencies": {
    "js-build-tools": "^5.2.0",
    "jsdoc": "^4.0.5",
    "standard": "^17.1.2",
    "test-filesystem": "^1.5.1"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/pseudo-dom.git"
  },
  "bugs": {
    "url": "https://github.com/jheagle/pseudo-dom/issues"
  },
  "homepage": "https://github.com/jheagle/pseudo-dom#readme",
  "keywords": [
    "dom",
    "mock",
    "pseudo-dom",
    "testing",
    "node",
    "typescript"
  ],
  "standard": {
    "env": [
      "jest"
    ]
  },
  "files": [
    "dist",
    "browser"
  ]
}
