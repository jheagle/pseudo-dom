{
  "name": "pseudo-dom",
  "description": "Mock the DOM on the server side for managing state and testing",
  "version": "1.1.0",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "unpkg": "browser/pseudo-dom.min.js",
  "jsdelivr": "browser/pseudo-dom.min.js",
  "author": "Joshua Heagle",
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "docs": "gulp docs",
    "publish:bundle": "gulp copyFiles",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest"
  },
  "dependencies": {
    "browser-or-node": "^3.0.0",
    "collect-your-stuff": "^2.3.0",
    "core-js": "^3.51.0",
    "css-select": "^6.0.0",
    "htmlparser2": "^9.1.0",
    "si-funciona": "^2.8.0"
  },
  "devDependencies": {
    "js-build-tools": "^6.3.0",
    "release-it": "^21.1.1",
    "standard": "^17.1.2",
    "test-filesystem": "^2.0.2",
    "typedoc": "^0.28.20"
  },
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/pseudo-dom.git"
  },
  "bugs": {
    "url": "https://github.com/jheagle/pseudo-dom/issues"
  },
  "homepage": "https://github.com/jheagle/pseudo-dom#readme",
  "keywords": [
    "dom",
    "mock",
    "pseudo-dom",
    "testing",
    "node",
    "typescript"
  ],
  "standard": {
    "env": [
      "jest"
    ]
  },
  "files": [
    "dist",
    "browser"
  ]
}
